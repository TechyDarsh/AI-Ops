# ==========================================
# AI-Ops Git Ignore Rules
# ==========================================

# 1. 3D Model Assets (Large GLB/GLTF binary files)
*.glb
*.gltf
*.bin
3D-Models/
**/3D-Models/
**/public/3D-Models/

# 2. Java / Maven build artifacts
**/target/
*.class
*.jar
*.war
*.ear
.mvn/
mvnw
mvnw.cmd

# 3. Node & JavaScript / TypeScript dependencies
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/.pnpm-store/
**/dist/
**/build/
.eslintcache

# 4. Mobile & Android build artifacts
**/.gradle/
**/build/
**/local.properties
**/*.apk
**/*.aab
**/android/app/build/
**/android/.gradle/
**/android/captures/

# 5. Python runtime & virtual environments
**/__pycache__/
*.py[cod]
*$py.class
**/.venv/
**/venv/
**/ENV/
**/env/

# 6. IDEs & Editors
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.DS_Store
Thumbs.db
desktop.ini

# 7. Environment & Secrets
.env
.env.local
.env.*.local
*.log
